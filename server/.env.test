# Route tests run against their own database so a test can truncate freely
# without eating a dev juror's career.
DATABASE_URL="postgresql://bonhomie@localhost:5432/fault_test?schema=public"
REDIS_URL="redis://localhost:6379/1"
JWT_SECRET="test-secret-that-is-comfortably-long-enough-for-hs256-signing"
ALLOW_DEV_AUTH="true"
NODE_ENV="test"
CORS_ORIGINS=""
# No Groq keys: tests must never spend real tokens or depend on a model's mood.
GROQ_API_KEY=""
GROQ_API_KEYS=""
PORT=4999
DISABLE_RATE_LIMITS="true"
# NOT set: ALLOW_FAKE_PURCHASES. A test must prove the store refuses an
# unverified receipt, which it cannot do if the store is handing them out.
