# Postgres — the city's memory
DATABASE_URL="postgresql://USER@localhost:5432/fault?schema=public"

# Redis — pre-generated case buffer + city state write-through cache
REDIS_URL="redis://localhost:6379"

# Groq — case generation. Without this key the server serves the
# hand-authored fallback docket instead (see src/services/seedCases.ts).
# A single key. Still supported, and folded into the pool below if both are set.
GROQ_API_KEY=""

# The pool, comma-separated, rotated (src/lib/groq.ts).
#
# Each free-tier key allows ~100,000 tokens/day, and a case costs ~3,000 — so
# ONE key is about 33 cases per day for the entire server, after which every
# juror silently drops to the fallback docket. The pool multiplies that
# ceiling: five keys ≈ 165 cases/day. It does not remove it. A real launch
# needs a paid tier.
GROQ_API_KEYS=""

GROQ_MODEL="llama-3.3-70b-versatile"

PORT=4000
NODE_ENV="development"

# ---- Identity ----
# Apple Sign In: your iOS bundle identifier. Every identityToken must name this
# as its audience, or a token minted for someone else's app would work here.
# Requires a paid Apple Developer account and a native dev build — Apple Sign
# In does not function in Expo Go.
APPLE_BUNDLE_ID="com.bonhomie95.fault"

# Google Sign In: comma-separated OAuth client ids (iOS, Android, Web all differ).
GOOGLE_CLIENT_IDS=""

# Development only. Lets the client authenticate with a device id so the game is
# playable in Expo Go before OAuth credentials exist. Ignored when
# NODE_ENV=production. Set to false once real auth is wired.
ALLOW_DEV_AUTH="true"

# ---- Sessions ----
# Signs access tokens (HS256). At least 32 chars; 48+ required in production.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# Comma-separated browser origins allowed to call the API. Native apps send no
# Origin and are always allowed. Empty is permissive and is REFUSED at boot when
# NODE_ENV=production.
CORS_ORIGINS=""

# ---- Payments ----
# Receipt verification refuses everything without these, which is deliberate:
# a server that cannot tell a real purchase from a made-up one must not guess.
#
# Apple: App Store Connect > Users and Access > Integrations > In-App Purchase.
APPLE_ISSUER_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""      # contents of the .p8, newlines as \n

# Google: a service account with Play Developer API access, JSON inline.
GOOGLE_SERVICE_ACCOUNT_JSON=""
ANDROID_PACKAGE_NAME="com.bonhomie95.fault"

# Accept unverified receipts. Development ONLY — this gives the paid game away.
# Separate from ALLOW_DEV_AUTH on purpose: signing in without Apple and buying
# the campaign for free are different risks. Refused at boot in production.
ALLOW_FAKE_PURCHASES="false"

# Skip rate limiting. Tests only; refused at boot in production.
DISABLE_RATE_LIMITS="false"
