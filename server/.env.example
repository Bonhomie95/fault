# Postgres — the city's memory
DATABASE_URL="postgresql://USER@localhost:5432/fault?schema=public"

# Redis — pre-generated case buffer + city state write-through cache
REDIS_URL="redis://localhost:6379"

# Groq — case generation. Without this key the server serves the
# hand-authored fallback docket instead (see src/services/seedCases.ts).
# A single key. Still supported, and folded into the pool below if both are set.
GROQ_API_KEY=""

# The pool, comma-separated, rotated (src/lib/groq.ts).
#
# Each free-tier key allows ~100,000 tokens/day, and a case costs ~3,000 — so
# ONE key is about 33 cases per day for the entire server, after which every
# juror silently drops to the fallback docket. The pool multiplies that
# ceiling: five keys ≈ 165 cases/day. It does not remove it. A real launch
# needs a paid tier.
GROQ_API_KEYS=""

# The same pool, one key per variable, for hosts whose secret managers do not
# like long comma-separated values. GROQ_API_KEY_1, _2, _3 ... are read
# straight off the environment and folded in with the two above.
#
# Worth knowing when running the tests: they clear GROQ_API_KEY and
# GROQ_API_KEYS, but anything numbered here is picked up from a real .env as
# well, and the suite will happily spend live tokens. tests/routes.test.ts
# deletes them explicitly for that reason.
# GROQ_API_KEY_1=""

GROQ_MODEL="openai/gpt-oss-120b"

PORT=4000
NODE_ENV="development"

# Postgres connections held per server instance. Defaults to 20 in production
# and 10 outside it, which is the setting this server is actually tuned around:
# a verdict makes roughly 38 sequential round trips, so the pool has to be deep
# enough that those never queue behind each other, and shallow enough that a
# fleet of four instances still leaves Postgres headroom.
#
# Raise it only with the arithmetic in hand — max_connections on the database
# divided by the number of instances, minus room for migrations and psql. A
# non-integer is refused at boot rather than silently becoming a pool with no
# limit (see src/lib/prisma.ts).
# DATABASE_POOL_MAX=20

# How many reverse proxies sit in front of this server.
#
# Express skips this many hops from the RIGHT of X-Forwarded-For to find the
# client IP, and every IP-keyed rate limit depends on getting it right. This
# was hardcoded to 1, which on a server with NO proxy means the entire header
# is attacker-supplied: one authenticated user rotating it pushed 180 requests
# through a 120/min limit without a single 429.
#
# 0 = no proxy; trust the socket and ignore the header. Count your actual hops
# before changing it — most PaaS front ends add 2 or more, not 1.
TRUST_PROXY_HOPS=0

# ---- Identity ----
# Apple Sign In: your iOS bundle identifier. Every identityToken must name this
# as its audience, or a token minted for someone else's app would work here.
# Requires a paid Apple Developer account and a native dev build — Apple Sign
# In does not function in Expo Go.
APPLE_BUNDLE_ID="com.bonhomie95.fault"

# Google Sign In: comma-separated OAuth client ids (iOS, Android, Web all differ).
GOOGLE_CLIENT_IDS=""

# Development only. Lets the client authenticate with a device id so the game is
# playable in Expo Go before OAuth credentials exist. Ignored when
# NODE_ENV=production. Set to false once real auth is wired.
ALLOW_DEV_AUTH="true"

# Guest accounts ("PLAY AS GUEST"), safe in production. The app generates a
# 256-bit secret once and keeps it in the keychain; the server stores only its
# SHA-256. Unlike ALLOW_DEV_AUTH this is a real credential, not a claim.
# Default true — a release build with it off has no door on Android until
# Google client ids exist.
ALLOW_GUEST_AUTH="true"

# Sign in with Apple token REVOCATION on account deletion (App Store guideline
# 5.1.1(v)). NOT the App Store Connect key under Payments below — Apple needs a
# "Sign in with Apple" key: developer.apple.com > Certificates, Identifiers &
# Profiles > Keys > + > enable "Sign in with Apple" > configure with the app's
# primary App ID. All empty = sign-in still works, revocation is skipped and
# logged at deletion.
APPLE_TEAM_ID=""               # 10-char Team ID (Membership page)
APPLE_SIGNIN_KEY_ID=""         # the key's 10-char id
APPLE_SIGNIN_PRIVATE_KEY=""    # contents of AuthKey_XXXX.p8, newlines as \n
APPLE_CLIENT_ID=""             # defaults to APPLE_BUNDLE_ID for a native app

# ---- Sessions ----
# Signs access tokens (HS256). At least 32 chars; 48+ required in production.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# Retired signing secrets, comma-separated. Accepted on verification, never
# used to sign.
#
# Without this, rotating JWT_SECRET invalidates every access token in flight —
# signing the whole player base out at once, mid-case for anyone holding a
# dossier with the clock running. A verdict cannot be retried, so "rotate the
# secret" was an operation you could never actually perform.
#
# To rotate: move the old value here, set a new JWT_SECRET, deploy, then remove
# this line after 30 minutes (one access-token lifetime).
JWT_SECRET_PREVIOUS=""

# Comma-separated browser origins allowed to call the API. Native apps send no
# Origin and are always allowed. Empty is permissive and is REFUSED at boot when
# NODE_ENV=production.
CORS_ORIGINS=""

# ---- Payments ----
# Receipt verification refuses everything without these, which is deliberate:
# a server that cannot tell a real purchase from a made-up one must not guess.
#
# Apple: App Store Connect > Users and Access > Integrations > In-App Purchase.
APPLE_ISSUER_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""      # contents of the .p8, newlines as \n

# Google: a service account with Play Developer API access, JSON inline.
GOOGLE_SERVICE_ACCOUNT_JSON=""
ANDROID_PACKAGE_NAME="com.bonhomie95.fault"

# Accept unverified receipts. Development ONLY — this gives the paid game away.
# Separate from ALLOW_DEV_AUTH on purpose: signing in without Apple and buying
# the campaign for free are different risks. Refused at boot in production.
ALLOW_FAKE_PURCHASES="false"

# Pay Merit for rewarded adverts. Keep false until an ad network with
# server-side verification (SSV) is wired in — POST /api/store/ad-reward
# otherwise trusts the client's word, and it 404s while this is false. The
# store hides the rewarded button while it is off.
ADS_SERVER_VERIFIED="false"

# Skip rate limiting. Tests only; refused at boot in production.
DISABLE_RATE_LIMITS="false"

# ---- Support and compliance ----
# This server's public origin. The legal documents (legal/*.md) are served
# from it at /legal/terms, /legal/privacy, /legal/dmca and /legal/community,
# and the privacy/terms URLs handed to the app default to those. On Render,
# RENDER_EXTERNAL_URL is set automatically and used when this is empty.
PUBLIC_BASE_URL=""

# Overrides, only if the policies should link somewhere OTHER than this
# server's own /legal pages (e.g. a marketing site mirroring them). Production
# no longer refuses to boot without these; it warns if no absolute URL can be
# derived at all.
PRIVACY_POLICY_URL=""
TERMS_URL=""

# Shown to a player when they file a content report, for anything urgent.
SUPPORT_EMAIL=""

# ---- Database pool ----
# Connections per instance. Defaults to 20 in production, 10 otherwise.
# Multiply by your instance count and keep it well under Postgres's
# max_connections (100 by default, minus superuser reservations) — scaling out
# with a careless value is an outage that arrives the moment you add the third
# instance.
# DATABASE_POOL_MAX=20
