// FAULT — persistence layer.
// The city is per-player: every juror inhabits their own city, shaped only by
// their own verdicts. Nothing here is shared across users except the aggregate
// consensus counters on Case.
//
// Cases are set in the player's real country and may name real jurisdictions
// and police services as setting. Every individual — defendant, witness,
// officer, counsel — is fictional. See caseGenerator's system prompt and
// content filter; that boundary is load-bearing, not stylistic.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: the connection URL lives in prisma.config.ts, and the runtime
// client is constructed with a driver adapter (see src/lib/prisma.ts).
datasource db {
  provider = "postgresql"
}

enum Verdict {
  guilty
  not_guilty
}

enum CorrectVerdict {
  guilty
  not_guilty
  ambiguous
}

enum CharacterRole {
  defendant
  witness
  prosecutor
  defender
  victim
}

/// How a character left your courtroom. Drives which echo they can return as.
enum CharacterFate {
  convicted
  acquitted
  untried // witnesses, counsel — never judged, but still remembered
}

enum AuthProvider {
  apple
  google
  device // dev/Expo Go bypass — never issued in production
}

/// The ladder. You start where you live and climb outward; nobody hears a
/// war-crimes case in their first week.
enum Tier {
  district      // where you live
  state         // region / fylke / province / state
  national      // federal
  supranational // EU, African Union, ASEAN, Mercosur...
  international // treaty courts
  world
}

/// Where an application to sit in another country stands.
enum ApplicationStatus {
  pending
  accepted
  rejected
  withdrawn
}

enum MissionKind {
  daily
  weekly
  career
}

/// Things a juror can own. Deliberately small, and deliberately none of them
/// touch rank, trust, verdicts or the clock — see domain/store.ts.
enum Entitlement {
  // ---- content: more game ----
  campaign      // the full docket, past the 10-case trial
  pack_corporate
  pack_cold_case
  pack_political

  // ---- convenience: less friction ----
  no_ads        // forever

  // ---- cosmetic: nothing but how it looks ----
  // These exist because they are the only honest way to take more money from
  // a game about integrity. They change the room, never the verdict.
  seal_brass    // the juror's seal on the record and the boards
  seal_obsidian
  seal_ivory
  room_oak      // the courtroom's wood and light
  room_concrete
  stock_onionskin // the dossier's paper
  stock_vellum

  room_marble
  room_night
  seal_gold     // the Juror Pass seal; only while the pass is live

  // ---- subscription ----
  pass          // the Juror Pass: expires (UserEntitlement.expiresAt)

  // ---- support ----
  patron        // named in the credits; a seal and a line, nothing more
}

enum PurchaseSource {
  store   // real money, via a validated receipt
  merit   // earned by playing
  grant   // support, promo, restore
}

/// Where Merit came from. Every one of these is service or attention —
/// none is "was your verdict right".
enum MeritReason {
  case_heard
  mission
  streak
  rewarded_ad
  purchase
  refund
  spend
  grant
}

model User {
  id           String   @id @default(cuid())
  /// Chosen by the player, always. The OAuth provider's display name is never
  /// adopted — you pick who you are in the jury room.
  ///
  /// Filtered and normalised on the way in (domain/jurorName): this string is
  /// published on the public leaderboard, so it is user-generated content and
  /// is treated as such.
  jurorName    String
  /// When the name last changed, for the rename cooldown. Null means never.
  /// A name that can change every few seconds cannot be reported by anyone,
  /// because it will not be the same name by the time a human looks.
  nameChangedAt DateTime?
  createdAt    DateTime @default(now())
  lastSeenAt   DateTime @default(now())

  /// The player's own timezone (IANA, e.g. "Europe/Oslo"), captured at
  /// sign-in. Streaks are a human thing: a day ends at the player's midnight,
  /// not at UTC's.
  timezone     String   @default("UTC")

  /// Merit — earned by service, spendable in the store. Never buys standing.
  /// The ledger in MeritEntry is the truth; this is the running total.
  merit        Int      @default(0)

  // NOTE: trialUnlocked is gone. Entitlements are rows now, and rows are only
  // ever written by a validated receipt or an earned purchase — never by the
  // client asking nicely. See the audit: the old boolean was settable straight
  // from PATCH /api/session/me, which made the paid campaign free.

  // ---- Where you are from ----
  // Set once at swearing-in from device location (or a picker if declined).
  // Only the country and district are ever stored: the personalisation is
  // country-level, so keeping coordinates would be collecting what the game
  // does not use.
  homeCountry  String?  // ISO 3166-1 alpha-2, e.g. "NO"
  homeDistrict String?  // real district within that country, e.g. "Oslo"
  /// Where the player is currently sitting. Starts at their home district and
  /// climbs; may sit in another country once an application is accepted.
  currentTier      Tier    @default(district)
  currentCountry   String?
  localeTag        String? // e.g. "nb-NO" — drives naming register

  // ---- Standing ----
  // Rank is service and only ever rises; it cannot spoil a case because it
  // does not know whether you were right. Trust is judgement, and it moves
  // only on delayed outcomes surfaced at review breaks (see progression.ts).
  rank         Int      @default(1)
  xp           Int      @default(0)
  trust        Float    @default(50)

  currentStreak Int     @default(0)
  longestStreak Int     @default(0)
  lastDocketDay String? // YYYY-MM-DD in the player's own day, for streaks

  // ---- Advertising ----
  // Cases heard since the last interstitial, and how many this stretch will
  // take (2 or 3, rolled fresh each time). Both live here rather than in the
  // client because an ad cadence the client owns is an ad cadence the client
  // skips — and because the roll must not be re-rollable by reopening the app.
  casesSinceAd  Int     @default(0)
  adEveryNCases Int     @default(3)

  // ---- The daily docket ----
  /// Streak shields held. One is spent, automatically, to cover each missed
  /// day so a streak survives a day off. Bought or earned; never needed.
  streakShields Int     @default(0)
  /// Extra cases opened today beyond the free docket (rewarded view or
  /// Merit), and the player's day they belong to. A new day zeroes them.
  bonusCases    Int     @default(0)
  bonusCasesDay String?
  /// Which cosmetics are on: the courtroom and the seal. Must be owned —
  /// the store route checks — and an expired pass quietly falls back.
  roomTheme     String?
  sealStyle     String?

  // ---- The map ----
  /// The district the player is currently presiding in, within their current
  /// country. Null means their home district. Other districts are UNLOCKED by
  /// rank (domain/districts) and chosen from the career screen.
  currentDistrict   String?
  /// Districts opened to this player, by name, in their current country.
  unlockedDistricts String[] @default([])

  // ---- Coming back ----
  /// The player's own day on which the daily summons was last collected.
  lastRewardDay  String?
  /// When the city last moved on its own. The city does not stand still while
  /// the player is away — see services/cityClock.
  lastCityTickAt DateTime @default(now())

  // ---- Consent & accounts ----
  /// When the player accepted the Terms and Privacy Policy, and which version.
  consentedAt     DateTime?
  consentVersion  String?
  /// Sign in with Apple refresh token, kept ONLY so account deletion can revoke
  /// it with Apple (App Store guideline 5.1.1(v)). Never sent to the client.
  appleRefreshToken String?

  news         NewsItem[]

  identities   AuthIdentity[]
  refreshTokens RefreshToken[]
  entitlements UserEntitlement[]
  purchases    Purchase[]
  meritLedger  MeritEntry[]
  adEvents     AdEvent[]
  applications JurisdictionApplication[]
  missions     MissionProgress[]
  cases        Case[]
  verdicts     VerdictRecord[]
  characters   Character[]
  reports      ContentReport[]
  cityState    CityState?
  jurorProfile JurorProfile?

  @@map("users")
}

/// A player telling us something is wrong.
///
/// Required by App Store Guideline 1.2 for the juror names on the public
/// registry, and required by common sense for the generated docket: this
/// server writes criminal accusations about invented people, set in named real
/// jurisdictions, without a human reading them first. The system prompt and
/// the content filter are good-faith controls, not guarantees, and the only
/// thing that matters when one fails is that there was a way to be told.
///
/// Deliberately kept after the account it refers to is gone — `reporterId` is
/// nulled rather than cascaded — because a report about a case is evidence
/// about the generator, and it outlives the person who filed it.
model ContentReport {
  id         String    @id @default(cuid())

  reporterId String?
  reporter   User?     @relation(fields: [reporterId], references: [id], onDelete: SetNull)

  /// "case" | "juror_name"
  kind       String
  /// The case id, or the user id whose name is being reported.
  subjectId  String
  reason     String
  detail     String?   @db.Text

  reviewedAt DateTime?
  /// What was done about it, in a human's words.
  resolution String?   @db.Text

  createdAt  DateTime  @default(now())

  @@index([reviewedAt, createdAt])
  @@index([kind, subjectId])
  @@map("content_reports")
}

/// Refresh tokens, stored hashed — a database dump should not be a pile of
/// working credentials. Rotated on every use so a stolen one surfaces loudly.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

/// What a juror owns. One row per thing; the row IS the entitlement.
model UserEntitlement {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  entitlement Entitlement
  source      PurchaseSource
  grantedAt   DateTime    @default(now())
  /// Null = forever. Set for subscriptions; the store's own expiry, re-read
  /// from Apple or Google on every renewal/restore.
  expiresAt   DateTime?

  @@unique([userId, entitlement])
  @@index([userId])
  @@map("user_entitlements")
}

/// Every purchase, money or Merit, for support and for restore.
model Purchase {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  sku         String
  source      PurchaseSource
  /// Minor units (cents/øre) at time of sale, or 0 for a Merit purchase.
  amountMinor Int            @default(0)
  currency    String         @default("USD")
  meritSpent  Int            @default(0)

  /// The store's own transaction id. Unique so a replayed receipt cannot be
  /// redeemed twice — the single most attacked path in any IAP flow.
  transactionId String?      @unique
  platform    String?        // "ios" | "android"
  createdAt   DateTime       @default(now())

  @@index([userId])
  @@map("purchases")
}

/// The Merit ledger. Append-only: the balance is derived from this, so a bug
/// in a grant is auditable rather than invisible.
model MeritEntry {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Positive earns, negative spends.
  delta     Int
  reason    MeritReason
  /// What caused it — a case id, a mission key, a sku.
  reference String?
  balance   Int         // running balance after this entry, for cheap audit
  createdAt DateTime    @default(now())

  @@index([userId, createdAt])
  @@map("merit_entries")
}

/// Rewarded-ad views. Rate-limited server-side: a rewarded ad pays Merit, so
/// without a cap it is a faucet anyone can hold open.
model AdEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind      String   // "rewarded" | "interstitial"
  /// What a rewarded view paid: "merit" or "case".
  reward    String?
  /// The ad network's own view id, so one view cannot be claimed twice.
  viewId    String?  @unique
  meritPaid Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("ad_events")
}

/// One row per provider per user, so a juror can attach both Apple and Google
/// to the same record and keep one career.
model AuthIdentity {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider   AuthProvider
  /// The provider's stable subject id. Never an email: Apple's private relay
  /// address can change, the subject cannot.
  subject    String
  /// Only stored when the provider shares it and the player consents. Apple
  /// gives this exactly once, at first authorisation.
  email      String?
  createdAt  DateTime     @default(now())

  @@unique([provider, subject])
  @@index([userId])
  @@map("auth_identities")
}

/// An application to sit as a juror somewhere you are not from (GDD extension).
/// Decided on the record: rank, trust, consistency, evidence alignment.
model JurisdictionApplication {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  country     String            // ISO alpha-2 being applied to
  tier        Tier
  status      ApplicationStatus @default(pending)
  /// The bench's written reasoning — the player reads a decision, not a score.
  decisionText String?          @db.Text
  /// Snapshot of what the record looked like when judged, so a later decision
  /// can be explained honestly.
  trustAtDecision Float?
  rankAtDecision  Int?
  decidedAt   DateTime?
  createdAt   DateTime          @default(now())

  @@index([userId, status])
  @@map("jurisdiction_applications")
}

/// Missions are the reason to come back. Progress is per-period so a daily
/// resets without destroying career-long objectives.
model MissionProgress {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  key        String      // stable mission id, e.g. "hear_three"
  kind       MissionKind
  /// The period this instance belongs to: "2026-07-16" daily, "2026-W29"
  /// weekly, "career" for career missions.
  period     String
  progress   Int         @default(0)
  target     Int
  claimed    Boolean     @default(false)
  completedAt DateTime?

  @@unique([userId, key, period])
  @@index([userId, period])
  @@map("mission_progress")
}

model CityState {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  crimeRate            Float    @default(50)
  judicialTrust        Float    @default(50)
  wealthDisparity      Float    @default(50)
  organizedCrimePower  Float    @default(50)
  policeIntegrity      Float    @default(50)
  mediaPressure        Float    @default(50)

  activeFactions       String[] @default([])

  /// The six dials collapsed to the one scalar both boards sort on
  /// (domain/peace.peaceIndex), stored rather than computed per query.
  ///
  /// The boards used to derive this inline in SQL, which meant ranking one
  /// player required building the ENTIRE ranking — sequential scan, hash join,
  /// full sort, window aggregate — and discarding every row but theirs. Fine
  /// at 25 players; a million-row sort per request at a million.
  ///
  /// Stored and indexed, a rank is `count(*) where peaceIndex > mine`: an
  /// index range count, which Postgres answers without touching the rows.
  ///
  /// Default 50 is not arbitrary — it is what peaceIndex() returns for the
  /// all-50 starting city, so a freshly created row is already correct.
  /// services/cityState is the only writer, and it recomputes on every write.
  peaceIndex           Float    @default(50)

  updatedAt            DateTime @updatedAt

  @@index([peaceIndex])
  @@map("city_state")
}

model Case {
  id                  String         @id @default(cuid())
  userId              String
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 1-indexed position in this player's docket. Drives chapter + echo windows.
  caseNumber          Int
  title               String
  charge              String
  accent              String         // case mood colour (GDD 5.1)
  mood                String         // derived from city state at generation time

  // ---- Where this case was heard ----
  country             String         @default("NO") // ISO alpha-2
  /// Real jurisdiction this sits in, e.g. "Oslo tingrett" / "Oslo politidistrikt".
  /// The institution is real; every person in the case is not.
  jurisdiction        String         @default("")
  tier                Tier           @default(district)

  defendantName       String
  defendantAge        Int
  defendantOccupation String
  defendantBackground String         @db.Text
  /// Wealth band 0-100. Never shown to the player; used to score
  /// socioeconomic_bias and to pick the city effect.
  defendantWealth     Float          @default(50)
  /// How sympathetic this defendant *looks* — 0 unsettling, 100 disarming.
  /// Drives the face and nothing else the player can read. Paired with the
  /// verdict it measures appearance_bias: whether a face changed your mind.
  /// Rolled server-side, blind to the verdict (domain/presentation).
  defendantAppearance Float          @default(50)
  /// BODY LANGUAGE — 0 closed and defensive, 100 open and still.
  /// The second thing a juror reads off a person and the second thing that
  /// means nothing. Measures demeanour_bias.
  defendantDemeanour  Float          @default(50)
  /// ODDITY — 0 unremarkable, 100 openly strange.
  /// The uncanny axis: a gaze that does not quite land, a face fractionally
  /// out of true. Measures oddity_bias — the bias people are least willing to
  /// admit to and least able to justify to a defendant.
  defendantOddity     Float          @default(50)

  evidence            Json           // Evidence[]
  witnesses           Json           // Witness[]
  prosecutionArgument String         @db.Text
  defenceArgument     String         @db.Text
  /// CourtroomLine[] — outbursts, witness asides, counsel jabs. Presentation.
  lines               Json           @default("[]")

  correctVerdict      CorrectVerdict
  /// Which side the evidence actually favours, for evidence_weight scoring.
  evidenceStrength    Float          @default(0) // -1 fully defence .. +1 fully prosecution
  isHandAuthored      Boolean        @default(false)

  /// Structural fingerprint. Two cases sharing this are the consistency probe
  /// (GDD 2.5): identical structure, delivered ~20 cases apart.
  structureKey        String?

  /// Community consensus for the "63% of players convicted" beat (GDD 11.4).
  consensusGuilty     Int            @default(0)
  consensusNotGuilty  Int            @default(0)

  /// When this case was first handed to the player. THE CLOCK.
  ///
  /// The deliberation window is measured from here, on the server, and the
  /// client's claimed timeRemaining is ignored entirely. Previously the clock
  /// existed only in the phone, which meant a player could report 119 seconds
  /// left on every verdict, or reload the screen to read the dossier at
  /// leisure. The 120 seconds is the whole game; it cannot live somewhere the
  /// player can edit it.
  ///
  /// Null until first served. Re-serving the same pending case does NOT reset
  /// it — that was the reload exploit.
  servedAt            DateTime?

  /// Withheld from the docket pending review, set the moment a player reports
  /// it. Not a delete: the case IS the evidence about how the generator went
  /// wrong, and deleting it destroys the only record of that.
  quarantinedAt       DateTime?

  /// A special docket this case was heard from ("corporate", "cold_case",
  /// "political"), or null for the ordinary docket. Packs are counted by it.
  pack                String?
  /// The Daily Trial this case is ("2026-09-22"), or null. One case, the same
  /// facts for every juror in the world that day; see DailyTrial.
  dailyKey            String?

  createdAt           DateTime       @default(now())

  verdict             VerdictRecord?
  characters          Character[]

  @@unique([userId, caseNumber])
  @@unique([userId, dailyKey])
  @@index([userId, structureKey])
  @@map("cases")
}

model VerdictRecord {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  caseId        String   @unique
  case          Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  verdict       Verdict
  /// Seconds left on the clock at the moment of decision. 0 = forced.
  timeRemaining Int
  /// True when the clock ran out and the game chose for you (GDD 2.2).
  wasHung       Boolean  @default(false)

  /// Newspaper-style downstream consequence, revealed at the next Dossier
  /// Review. Written at verdict time, read 10 cases later.
  outcomeText   String?  @db.Text
  outcomeSeen   Boolean  @default(false)

  /// What this verdict will eventually do to your standing.
  ///
  /// Computed at verdict time but deliberately NOT applied then: trust that
  /// moved the instant you tapped would tell you whether you were right, and
  /// the game does not do that (GDD 2.6). It lands at the review break,
  /// alongside the outcome that justifies it.
  trustDelta    Float    @default(0)
  trustApplied  Boolean  @default(false)
  xpAwarded     Int      @default(0)

  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@map("verdicts")
}

model Character {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  name           String
  role           CharacterRole
  fate           CharacterFate
  /// Portrait seed — silhouettes are deterministic per character (GDD 5.2),
  /// so a returning face is the same face.
  portraitSeed   Int
  themes         String[]      @default([])

  originCaseId   String
  originCase     Case          @relation(fields: [originCaseId], references: [id], onDelete: Cascade)
  originCaseNumber Int
  lastUsedCase   Int
  relevanceScore Float         @default(0)
  /// Times this person has come back. Caps runaway reuse.
  echoCount      Int           @default(0)

  createdAt      DateTime      @default(now())

  /// A name IS this person's identity, so one juror cannot hold two rows for
  /// the same name.
  ///
  /// addToCharacterPool does findFirst-then-create, which two concurrent
  /// writes both pass — and the result is not a duplicate row, it is a person
  /// split in half: half their echoes point at one row and half at the other,
  /// their fate and echoCount diverge, and the "PREVIOUSLY BEFORE YOU" note
  /// starts referring to a stranger. The constraint is what actually prevents
  /// that; the upsert in the service is the graceful path to the same rule.
  @@unique([userId, name])
  @@index([userId, lastUsedCase])
  @@map("characters")
}

model JurorProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  convictionRate    Float    @default(0)
  evidenceWeight    Float    @default(0)
  socioeconomicBias Float    @default(0)
  consistencyScore  Float    @default(0)
  pressureAccuracy  Float    @default(0)
  gutAccuracy       Float    @default(0)
  /// The seventh measurement: do you acquit the ones who look harmless?
  /// Positive = convicts unsettling-looking defendants more readily.
  appearanceBias    Float    @default(0)
  /// The eighth: do you convict the ones who sit closed and will not open up?
  /// Positive = convicts closed, defensive defendants more readily.
  demeanourBias     Float    @default(0)
  /// The ninth, and the one nobody wants to see: do you convict the strange?
  /// Positive = convicts defendants who strike you as odd more readily.
  oddityBias        Float    @default(0)

  totalCases        Int      @default(0)
  /// Groq-written prose profile (GDD 7.5). Regenerated at each review break.
  writtenProfile    String?  @db.Text
  updatedAt         DateTime @updatedAt

  /// The leaderboard filters on `totalCases >= MIN_CASES_TO_RANK` and had no
  /// index for it, so qualifying every player meant a sequential scan of this
  /// table on every board request.
  @@index([totalCases])
  @@map("juror_profiles")
}

/// What the city's papers print about the player's docket and its fallout.
///
/// News is the consequence layer made visible: a verdict moves the city's
/// dials, and the dials make the news — backlash, robberies, protests, a
/// syndicate getting bolder, a reform bill. Written by services/news, keyed to
/// the player, and read from the lobby's front page.
model NewsItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  /// The masthead: "The Kano Herald", "Radio Kano", "@KanoWatch".
  outlet    String
  kind      NewsKind
  headline  String
  body      String   @db.Text
  district  String?
  /// The case that set this off, if one did.
  caseId    String?
  /// 1 local colour .. 3 front page.
  severity  Int      @default(1)
  read      Boolean  @default(false)

  @@index([userId, createdAt])
  @@map("news_items")
}

enum NewsKind {
  verdict
  backlash
  crime
  protest
  reform
  syndicate
  police
  economy
  press
  echo
  city
}

/// The Daily Trial: one case a day, the same facts for everyone, told in each
/// juror's own country. The tally is how the world split — never whether it
/// was right.
model DailyTrial {
  day        String   @id // YYYY-MM-DD, UTC
  /// The generated case (GeneratedCase JSON) with its placeholder cast, or
  /// null when the day fell back to the authored docket (seedIndex).
  payload    Json?
  seedIndex  Int?
  guilty     Int      @default(0)
  notGuilty  Int      @default(0)
  hung       Int      @default(0)
  createdAt  DateTime @default(now())

  @@map("daily_trials")
}
