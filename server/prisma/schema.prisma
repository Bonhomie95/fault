// FAULT — persistence layer.
// The city is per-player: every juror inhabits their own city, shaped only by
// their own verdicts. Nothing here is shared across users except the aggregate
// consensus counters on Case.
//
// Cases are set in the player's real country and may name real jurisdictions
// and police services as setting. Every individual — defendant, witness,
// officer, counsel — is fictional. See caseGenerator's system prompt and
// content filter; that boundary is load-bearing, not stylistic.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: the connection URL lives in prisma.config.ts, and the runtime
// client is constructed with a driver adapter (see src/lib/prisma.ts).
datasource db {
  provider = "postgresql"
}

enum Verdict {
  guilty
  not_guilty
}

enum CorrectVerdict {
  guilty
  not_guilty
  ambiguous
}

enum CharacterRole {
  defendant
  witness
  prosecutor
  defender
  victim
}

/// How a character left your courtroom. Drives which echo they can return as.
enum CharacterFate {
  convicted
  acquitted
  untried // witnesses, counsel — never judged, but still remembered
}

enum AuthProvider {
  apple
  google
  device // dev/Expo Go bypass — never issued in production
}

/// The ladder. You start where you live and climb outward; nobody hears a
/// war-crimes case in their first week.
enum Tier {
  district      // where you live
  state         // region / fylke / province / state
  national      // federal
  supranational // EU, African Union, ASEAN, Mercosur...
  international // treaty courts
  world
}

/// Where an application to sit in another country stands.
enum ApplicationStatus {
  pending
  accepted
  rejected
  withdrawn
}

enum MissionKind {
  daily
  weekly
  career
}

/// Things a juror can own. Deliberately small, and deliberately none of them
/// touch rank, trust, verdicts or the clock — see domain/store.ts.
enum Entitlement {
  campaign      // the full docket, past the 10-case trial
  no_ads        // forever
  pack_corporate
  pack_cold_case
  pack_political
}

enum PurchaseSource {
  store   // real money, via a validated receipt
  merit   // earned by playing
  grant   // support, promo, restore
}

/// Where Merit came from. Every one of these is service or attention —
/// none is "was your verdict right".
enum MeritReason {
  case_heard
  mission
  streak
  rewarded_ad
  purchase
  refund
  spend
  grant
}

model User {
  id           String   @id @default(cuid())
  /// Chosen by the player, always. The OAuth provider's display name is never
  /// adopted — you pick who you are in the jury room.
  jurorName    String
  createdAt    DateTime @default(now())
  lastSeenAt   DateTime @default(now())

  /// The player's own timezone (IANA, e.g. "Europe/Oslo"), captured at
  /// sign-in. Streaks are a human thing: a day ends at the player's midnight,
  /// not at UTC's.
  timezone     String   @default("UTC")

  /// Merit — earned by service, spendable in the store. Never buys standing.
  /// The ledger in MeritEntry is the truth; this is the running total.
  merit        Int      @default(0)

  // NOTE: trialUnlocked is gone. Entitlements are rows now, and rows are only
  // ever written by a validated receipt or an earned purchase — never by the
  // client asking nicely. See the audit: the old boolean was settable straight
  // from PATCH /api/session/me, which made the paid campaign free.

  // ---- Where you are from ----
  // Set once at swearing-in from device location (or a picker if declined).
  // Only the country and district are ever stored: the personalisation is
  // country-level, so keeping coordinates would be collecting what the game
  // does not use.
  homeCountry  String?  // ISO 3166-1 alpha-2, e.g. "NO"
  homeDistrict String?  // real district within that country, e.g. "Oslo"
  /// Where the player is currently sitting. Starts at their home district and
  /// climbs; may sit in another country once an application is accepted.
  currentTier      Tier    @default(district)
  currentCountry   String?
  localeTag        String? // e.g. "nb-NO" — drives naming register

  // ---- Standing ----
  // Rank is service and only ever rises; it cannot spoil a case because it
  // does not know whether you were right. Trust is judgement, and it moves
  // only on delayed outcomes surfaced at review breaks (see progression.ts).
  rank         Int      @default(1)
  xp           Int      @default(0)
  trust        Float    @default(50)

  currentStreak Int     @default(0)
  longestStreak Int     @default(0)
  lastDocketDay String? // YYYY-MM-DD in the player's own day, for streaks

  identities   AuthIdentity[]
  refreshTokens RefreshToken[]
  entitlements UserEntitlement[]
  purchases    Purchase[]
  meritLedger  MeritEntry[]
  adEvents     AdEvent[]
  applications JurisdictionApplication[]
  missions     MissionProgress[]
  cases        Case[]
  verdicts     VerdictRecord[]
  characters   Character[]
  cityState    CityState?
  jurorProfile JurorProfile?

  @@map("users")
}

/// Refresh tokens, stored hashed — a database dump should not be a pile of
/// working credentials. Rotated on every use so a stolen one surfaces loudly.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

/// What a juror owns. One row per thing; the row IS the entitlement.
model UserEntitlement {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  entitlement Entitlement
  source      PurchaseSource
  grantedAt   DateTime    @default(now())

  @@unique([userId, entitlement])
  @@index([userId])
  @@map("user_entitlements")
}

/// Every purchase, money or Merit, for support and for restore.
model Purchase {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  sku         String
  source      PurchaseSource
  /// Minor units (cents/øre) at time of sale, or 0 for a Merit purchase.
  amountMinor Int            @default(0)
  currency    String         @default("USD")
  meritSpent  Int            @default(0)

  /// The store's own transaction id. Unique so a replayed receipt cannot be
  /// redeemed twice — the single most attacked path in any IAP flow.
  transactionId String?      @unique
  platform    String?        // "ios" | "android"
  createdAt   DateTime       @default(now())

  @@index([userId])
  @@map("purchases")
}

/// The Merit ledger. Append-only: the balance is derived from this, so a bug
/// in a grant is auditable rather than invisible.
model MeritEntry {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Positive earns, negative spends.
  delta     Int
  reason    MeritReason
  /// What caused it — a case id, a mission key, a sku.
  reference String?
  balance   Int         // running balance after this entry, for cheap audit
  createdAt DateTime    @default(now())

  @@index([userId, createdAt])
  @@map("merit_entries")
}

/// Rewarded-ad views. Rate-limited server-side: a rewarded ad pays Merit, so
/// without a cap it is a faucet anyone can hold open.
model AdEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind      String   // "rewarded" | "interstitial"
  /// The ad network's own view id, so one view cannot be claimed twice.
  viewId    String?  @unique
  meritPaid Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("ad_events")
}

/// One row per provider per user, so a juror can attach both Apple and Google
/// to the same record and keep one career.
model AuthIdentity {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider   AuthProvider
  /// The provider's stable subject id. Never an email: Apple's private relay
  /// address can change, the subject cannot.
  subject    String
  /// Only stored when the provider shares it and the player consents. Apple
  /// gives this exactly once, at first authorisation.
  email      String?
  createdAt  DateTime     @default(now())

  @@unique([provider, subject])
  @@index([userId])
  @@map("auth_identities")
}

/// An application to sit as a juror somewhere you are not from (GDD extension).
/// Decided on the record: rank, trust, consistency, evidence alignment.
model JurisdictionApplication {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  country     String            // ISO alpha-2 being applied to
  tier        Tier
  status      ApplicationStatus @default(pending)
  /// The bench's written reasoning — the player reads a decision, not a score.
  decisionText String?          @db.Text
  /// Snapshot of what the record looked like when judged, so a later decision
  /// can be explained honestly.
  trustAtDecision Float?
  rankAtDecision  Int?
  decidedAt   DateTime?
  createdAt   DateTime          @default(now())

  @@index([userId, status])
  @@map("jurisdiction_applications")
}

/// Missions are the reason to come back. Progress is per-period so a daily
/// resets without destroying career-long objectives.
model MissionProgress {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  key        String      // stable mission id, e.g. "hear_three"
  kind       MissionKind
  /// The period this instance belongs to: "2026-07-16" daily, "2026-W29"
  /// weekly, "career" for career missions.
  period     String
  progress   Int         @default(0)
  target     Int
  claimed    Boolean     @default(false)
  completedAt DateTime?

  @@unique([userId, key, period])
  @@index([userId, period])
  @@map("mission_progress")
}

model CityState {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  crimeRate            Float    @default(50)
  judicialTrust        Float    @default(50)
  wealthDisparity      Float    @default(50)
  organizedCrimePower  Float    @default(50)
  policeIntegrity      Float    @default(50)
  mediaPressure        Float    @default(50)

  activeFactions       String[] @default([])
  updatedAt            DateTime @updatedAt

  @@map("city_state")
}

model Case {
  id                  String         @id @default(cuid())
  userId              String
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 1-indexed position in this player's docket. Drives chapter + echo windows.
  caseNumber          Int
  title               String
  charge              String
  accent              String         // case mood colour (GDD 5.1)
  mood                String         // derived from city state at generation time

  // ---- Where this case was heard ----
  country             String         @default("NO") // ISO alpha-2
  /// Real jurisdiction this sits in, e.g. "Oslo tingrett" / "Oslo politidistrikt".
  /// The institution is real; every person in the case is not.
  jurisdiction        String         @default("")
  tier                Tier           @default(district)

  defendantName       String
  defendantAge        Int
  defendantOccupation String
  defendantBackground String         @db.Text
  /// Wealth band 0-100. Never shown to the player; used to score
  /// socioeconomic_bias and to pick the city effect.
  defendantWealth     Float          @default(50)
  /// How sympathetic this defendant *looks* — 0 unsettling, 100 disarming.
  /// Drives the 3D face and nothing else the player can read. Paired with the
  /// verdict it measures appearance_bias: whether a face changed your mind.
  /// Deliberately uncorrelated with guilt at generation time.
  defendantAppearance Float          @default(50)

  evidence            Json           // Evidence[]
  witnesses           Json           // Witness[]
  prosecutionArgument String         @db.Text
  defenceArgument     String         @db.Text

  correctVerdict      CorrectVerdict
  /// Which side the evidence actually favours, for evidence_weight scoring.
  evidenceStrength    Float          @default(0) // -1 fully defence .. +1 fully prosecution
  isHandAuthored      Boolean        @default(false)

  /// Structural fingerprint. Two cases sharing this are the consistency probe
  /// (GDD 2.5): identical structure, delivered ~20 cases apart.
  structureKey        String?

  /// Community consensus for the "63% of players convicted" beat (GDD 11.4).
  consensusGuilty     Int            @default(0)
  consensusNotGuilty  Int            @default(0)

  /// When this case was first handed to the player. THE CLOCK.
  ///
  /// The deliberation window is measured from here, on the server, and the
  /// client's claimed timeRemaining is ignored entirely. Previously the clock
  /// existed only in the phone, which meant a player could report 119 seconds
  /// left on every verdict, or reload the screen to read the dossier at
  /// leisure. The 120 seconds is the whole game; it cannot live somewhere the
  /// player can edit it.
  ///
  /// Null until first served. Re-serving the same pending case does NOT reset
  /// it — that was the reload exploit.
  servedAt            DateTime?

  createdAt           DateTime       @default(now())

  verdict             VerdictRecord?
  characters          Character[]

  @@unique([userId, caseNumber])
  @@index([userId, structureKey])
  @@map("cases")
}

model VerdictRecord {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  caseId        String   @unique
  case          Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  verdict       Verdict
  /// Seconds left on the clock at the moment of decision. 0 = forced.
  timeRemaining Int
  /// True when the clock ran out and the game chose for you (GDD 2.2).
  wasHung       Boolean  @default(false)

  /// Newspaper-style downstream consequence, revealed at the next Dossier
  /// Review. Written at verdict time, read 10 cases later.
  outcomeText   String?  @db.Text
  outcomeSeen   Boolean  @default(false)

  /// What this verdict will eventually do to your standing.
  ///
  /// Computed at verdict time but deliberately NOT applied then: trust that
  /// moved the instant you tapped would tell you whether you were right, and
  /// the game does not do that (GDD 2.6). It lands at the review break,
  /// alongside the outcome that justifies it.
  trustDelta    Float    @default(0)
  trustApplied  Boolean  @default(false)
  xpAwarded     Int      @default(0)

  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@map("verdicts")
}

model Character {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  name           String
  role           CharacterRole
  fate           CharacterFate
  /// Portrait seed — silhouettes are deterministic per character (GDD 5.2),
  /// so a returning face is the same face.
  portraitSeed   Int
  themes         String[]      @default([])

  originCaseId   String
  originCase     Case          @relation(fields: [originCaseId], references: [id], onDelete: Cascade)
  originCaseNumber Int
  lastUsedCase   Int
  relevanceScore Float         @default(0)
  /// Times this person has come back. Caps runaway reuse.
  echoCount      Int           @default(0)

  createdAt      DateTime      @default(now())

  @@index([userId, lastUsedCase])
  @@map("characters")
}

model JurorProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  convictionRate    Float    @default(0)
  evidenceWeight    Float    @default(0)
  socioeconomicBias Float    @default(0)
  consistencyScore  Float    @default(0)
  pressureAccuracy  Float    @default(0)
  gutAccuracy       Float    @default(0)
  /// The seventh measurement: do you acquit the ones who look harmless?
  /// Positive = convicts unsettling-looking defendants more readily.
  appearanceBias    Float    @default(0)

  totalCases        Int      @default(0)
  /// Groq-written prose profile (GDD 7.5). Regenerated at each review break.
  writtenProfile    String?  @db.Text
  updatedAt         DateTime @updatedAt

  @@map("juror_profiles")
}
